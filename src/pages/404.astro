---
import Layout from '../layouts/Layout.astro';
import { ArrowLeft } from 'lucide-react';
---

<Layout title="Page Not Found | RK Printers">
  <div class="min-h-[60vh] flex items-center justify-center py-20 px-4 text-center">
    <div class="max-w-md mx-auto">
      <div class="grid h-16 w-16 place-items-center rounded-2xl bg-rk-red/10 text-rk-red mx-auto font-heading font-extrabold text-2xl mb-6">
        404
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-4xl text-ink">Page Not Found</h1>
      <p class="mt-3 text-ink-soft">The page you are looking for doesn't exist or has been moved.</p>
      <div class="mt-8">
        <a href="/" class="inline-flex items-center gap-2 rounded-lg bg-rk-red px-6 py-3 text-sm font-semibold text-white hover:opacity-90 transition">
          <ArrowLeft className="h-4 w-4" /> Back to Home
        </a>
      </div>
    </div>
  </div>
</Layout>

