---
import Layout from '../layouts/Layout.astro';
import Portfolio from '../views/Portfolio.jsx';
import { PORTFOLIO_ITEMS } from '../data/siteData';
import { BRAND } from '../lib/brand';
---

<Layout
  title={`Our Portfolio & Client Work | ${BRAND.name}`}
  description="Browse our recent showcase of high-end signage fabrication, luxury packaging boxes, corporate stationery, and expo booths."
>
  <Portfolio client:load initialItems={PORTFOLIO_ITEMS} />
</Layout>

