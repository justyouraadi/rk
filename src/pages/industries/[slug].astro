---
import Layout from '../../layouts/Layout.astro';
import IndustryDetail from '../../views/IndustryDetail.jsx';
import allIndustries from '../../data/allIndustries.json';

export function getStaticPaths() {
  return allIndustries.map((industry) => ({
    params: { slug: industry.slug },
    props: {
      industry,
    }
  }));
}

const { industry } = Astro.props;
---

<Layout
  title={`${industry.name} Printing & Branding Solutions | RK Printers`}
  description={industry.description}
>
  <IndustryDetail client:load industry={industry} slug={industry.slug} />
</Layout>

