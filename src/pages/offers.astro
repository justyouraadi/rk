---
import Layout from '../layouts/Layout.astro';
import Offers from '../views/Offers.jsx';
import { OFFERS } from '../data/siteData';
import { BRAND } from '../lib/brand';
---

<Layout
  title={`Special Offers & Discounts | ${BRAND.name}`}
  description="Exclusive deals and discounts on business cards, brochures, standees, and annual hospital stationery packages."
>
  <Offers client:load initialOffers={OFFERS} />
</Layout>

